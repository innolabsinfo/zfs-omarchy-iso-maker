diff --git a/configs/airootfs/usr/share/omarchy-iso/zfs.sh b/configs/airootfs/usr/share/omarchy-iso/zfs.sh
new file mode 100644
index 0000000..891ea5e
--- /dev/null
+++ b/configs/airootfs/usr/share/omarchy-iso/zfs.sh
@@ -0,0 +1,279 @@
+# ZFS root helpers for the Omarchy installer (mode "zfs").
+#
+# Full disk, ONE natively-encrypted pool (aes-256-gcm, passphrase), /boot inside
+# the encrypted root, ZFSBootMenu on the ESP. No btrfs, no Limine, no
+# hibernation. Snapshoty: ZFS + boot environments ZBM.
+#
+# Sourced by the configurator (zfs_prepare_target) and by the orchestrator's
+# finalize phase (zfs_finalize_boot). Verified recipe: see
+# ~/work/zfs-proto/proto1-build.sh.
+#
+# Sourced, not executed. The configurator provides disk_step/disk_abort_hook;
+# tests/other callers get plain fallbacks.
+
+ZFS_POOL="${ZFS_POOL:-zroot}"
+ZFS_DATASET="${ZFS_DATASET:-omarchy}"
+ZFS_KEYFILE=/tmp/omarchy-zfs.key
+
+_zfs_say() { printf '\n\033[1;36m==> %s\033[0m\n' "$*"; }
+
+# Standalone use from the orchestrator: pull in the partition helpers if the
+# configurator has not already sourced them, and provide an abort fallback.
+if ! declare -F partition_path >/dev/null 2>&1; then
+  # shellcheck disable=SC1091
+  source "${DISK_PARTITIONING:-/usr/share/omarchy-iso/disk-partitioning.sh}"
+fi
+if ! declare -F disk_abort_hook >/dev/null 2>&1; then
+  disk_abort_hook() { printf 'Error: %s\n' "$1" >&2; exit 1; }
+fi
+
+# ── PREPARE (runs in the live ISO, before archinstall) ───────────────────────
+# Args: <disk> <passphrase> <kernel> <esp_mount_in_target>
+# Creates the pool and mounts the target so archinstall can install into it
+# with config_type=pre_mounted_config. Idempotent enough to re-run after a
+# failed attempt (wipes the disk).
+zfs_prepare_target() {
+  local disk="$1" pass="${2:-${OMARCHY_ZFS_PASSPHRASE:-}}" kernel="${3:-linux-omarchy}" esp_mount="${4:-/boot}"
+  (( ${#pass} >= 8 )) ||
+    disk_abort_hook "Haslo szyfrowania ZFS musi miec min. 8 znakow (jest ${#pass})"
+  local mib=$((1024 * 1024)) gib=$((1024 * 1024 * 1024))
+  local disk_size boot_start boot_size main_start main_size
+  local efi_dev pool_dev
+
+  disk_size=$(lsblk -bdno SIZE "$disk")
+  disk_size=$((disk_size / mib * mib))
+  boot_start=$mib
+  boot_size=$gib
+  # 1 MiB gap after the ESP: parted rejects a start that lands on the previous
+  # partition's last sector, so a flush start fails with "closest location".
+  main_start=$((boot_start + boot_size + mib))
+  main_size=$((disk_size - main_start - mib))
+
+  disk_step "wiping $disk" sgdisk --zap-all "$disk"
+  # zap-all leaves the disk label-less; parted mkpart needs a table first.
+  disk_step "initializing GPT on $disk" parted --script "$disk" mklabel gpt
+  partprobe "$disk" 2>/dev/null || true; udevadm settle; sleep 1
+  disk_step "creating ESP on $disk" \
+    parted --script "$disk" mkpart primary fat32 "${boot_start}B" "$((boot_start + boot_size))B"
+  disk_step "flagging ESP" parted --script "$disk" set 1 esp on
+  disk_step "creating ZFS partition on $disk" \
+    parted --script "$disk" mkpart primary "${main_start}B" "$((main_start + main_size))B"
+  partprobe "$disk"; udevadm settle; sleep 1
+
+  efi_dev=$(partition_path "$disk" 1)
+  pool_dev=$(partition_path "$disk" 2)
+  wait_for_device "$efi_dev" || disk_abort_hook "ESP $efi_dev never appeared"
+  wait_for_device "$pool_dev" || disk_abort_hook "ZFS partition $pool_dev never appeared"
+  disk_step "clearing ESP signatures" wipefs -af "$efi_dev"
+  disk_step "clearing ZFS partition signatures" wipefs -af "$pool_dev"
+  disk_step "creating the ESP filesystem on $efi_dev" mkfs.vfat -F32 -n OMARCHY_EFI "$efi_dev"
+
+  # Key file lives on the (host) live env only long enough to create the pool;
+  # it is copied into the encrypted target and becomes the initramfs key.
+  printf '%s' "$pass" >"$ZFS_KEYFILE"; chmod 600 "$ZFS_KEYFILE"
+
+  _zfs_say "Creating encrypted pool $ZFS_POOL"
+  disk_step "creating the ZFS pool" \
+    zpool create -f -o ashift=12 -o autotrim=on -o cachefile=none \
+      -O compression=lz4 -O acltype=posixacl -O xattr=sa -O relatime=on \
+      -O dnodesize=auto -O normalization=formD \
+      -O mountpoint=none -O canmount=off \
+      -O encryption=aes-256-gcm -O keyformat=passphrase \
+      -O keylocation="file://$ZFS_KEYFILE" \
+      -R /mnt "$ZFS_POOL" "$pool_dev"
+
+  disk_step "creating ROOT dataset" zfs create -o mountpoint=none "$ZFS_POOL/ROOT"
+  disk_step "creating root dataset" \
+    zfs create -o mountpoint=/ -o canmount=noauto "$ZFS_POOL/ROOT/$ZFS_DATASET"
+  disk_step "creating home dataset" zfs create -o mountpoint=/home "$ZFS_POOL/home"
+  disk_step "creating var dataset" zfs create -o mountpoint=none "$ZFS_POOL/var"
+  # -p so intermediate datasets (var/cache) are created too.
+  disk_step "creating var/log dataset" \
+    zfs create -p -o mountpoint=/var/log "$ZFS_POOL/var/log"
+  disk_step "creating pkg cache dataset" \
+    zfs create -p -o mountpoint=/var/cache/pacman/pkg "$ZFS_POOL/var/cache/pacman"
+  disk_step "setting bootfs" zpool set bootfs="$ZFS_POOL/ROOT/$ZFS_DATASET" "$ZFS_POOL"
+
+  _zfs_say "Export / reimport / mount"
+  disk_step "exporting the pool" zpool export "$ZFS_POOL"
+  disk_step "importing the pool" zpool import -N -R /mnt "$ZFS_POOL"
+  disk_step "loading the encryption key" zfs load-key "$ZFS_POOL"
+  disk_step "mounting root" zfs mount "$ZFS_POOL/ROOT/$ZFS_DATASET"
+  disk_step "mounting home" zfs mount "$ZFS_POOL/home"
+  disk_step "mounting var/log" zfs mount "$ZFS_POOL/var/log"
+  disk_step "mounting pkg cache" zfs mount "$ZFS_POOL/var/cache/pacman"
+  # /boot must live on the ZFS root: ZFSBootMenu mounts the BE and reads the
+  # kernel from /boot, and a separate ESP mounted at /boot is invisible there.
+  # The ESP (ZBM's EFI bundle) goes to $esp_mount (default /efi).
+  mkdir -p /mnt/boot
+  mkdir -p "/mnt$esp_mount"
+  disk_step "mounting ESP" mount "$efi_dev" "/mnt$esp_mount"
+
+  # Key inside the encrypted target; pool points at it. ZBM overrides the
+  # file:// keylocation to prompt (it cannot read it), so one prompt, and the
+  # target initramfs (which carries the same file) does not prompt again.
+  mkdir -p /mnt/etc/zfs
+  cp "$ZFS_KEYFILE" /mnt/etc/zfs/zroot.key
+  chmod 000 /mnt/etc/zfs/zroot.key
+  zfs set keylocation=file:///etc/zfs/zroot.key "$ZFS_POOL"
+
+  # OS kernel command line (busybox `zfs` hook mounts root from bootfs).
+  # zfs_force=1 makes the hook import with `zpool import -f`. The pool is left
+  # imported by the live installer (and re-imported by ZFSBootMenu) and is never
+  # cleanly exported, so a plain import refuses with "pool was previously in use
+  # from another system" -- the initramfs init then exits and the kernel panics
+  # with "Attempted to kill init" before root is ever mounted.
+  zfs set org.zfsbootmenu:commandline="zfs=bootfs rw zfs_force=1" \
+    "$ZFS_POOL/ROOT/$ZFS_DATASET"
+
+  # fstab: only the ESP. ZFS datasets mount from their properties. nofail so a
+  # missing ESP can never drop the system into emergency mode.
+  local esp_uuid
+  esp_uuid=$(blkid -s UUID -o value "$efi_dev")
+  cat >/mnt/etc/fstab <<EOF
+# /etc/fstab — generated by Omarchy ISO (ZFS root)
+# <device>  <mount>  <fs>  <options>  <dump>  <pass>
+UUID=$esp_uuid  $esp_mount  vfat  umask=0077,nofail,x-systemd.automount  0 0
+EOF
+
+  # Stable hostid so the pool imports deterministically.
+  zgenhostid -f 0x00bab10c 2>/dev/null || true
+  [[ -f /etc/hostid ]] && cp -f /etc/hostid /mnt/etc/hostid
+
+  mountpoint -q /mnt || disk_abort_hook "target /mnt is not mounted"
+}
+
+# ── FINALIZE (runs in the target chroot, after package install) ──────────────
+# Configures initramfs (busybox hooks + zfs + key) and installs ZFSBootMenu.
+# Args: <target> <kernel> <efi_binary_path>
+zfs_finalize_boot() {
+  local target="$1" kernel="$2" esp_mount="$3"
+  local keyfile="/etc/zfs/zroot.key"
+
+  _zfs_say "Purging the Limine/Snapper stack (unused on a ZFS root)"
+  # The omarchy meta-package pulls limine, limine-mkinitcpio-hook,
+  # limine-snapper-sync and snapper. On ZFS these are actively wrong:
+  # limine-mkinitcpio-hook installs its own pacman hook that builds a UKI +
+  # limine.conf instead of leaving a plain vmlinuz/initramfs for ZFSBootMenu,
+  # and it drives a btrfs-only HOOKS set. Remove the whole stack (ignoring the
+  # omarchy dependency), plus any leftover limine mkinitcpio boot hooks.
+  arch-chroot "$target" bash -euo pipefail -c '
+    pacman -Rdd --noconfirm limine limine-mkinitcpio-hook limine-snapper-sync snapper 2>/dev/null || true
+    rm -rf /etc/boot/hooks/pre.d /etc/boot/hooks/post.d
+    rm -f /etc/pacman.d/hooks/90-mkinitcpio-install.hook
+  '
+
+  _zfs_say "Configuring ZFS initramfs hooks"
+  # omarchy_hooks.conf OVERRIDES HOOKS with a btrfs+LUKS+Limine set (no zfs) and
+  # omarchy_resume.conf adds a btrfs-swap resume hook. Neither fits ZFS: move
+  # them aside so the ZFS set below is authoritative.
+  arch-chroot "$target" bash -euo pipefail -c '
+    set -e
+    mkdir -p /etc/mkinitcpio.conf.d
+    for f in omarchy_hooks.conf omarchy_resume.conf; do
+      [ -e "/etc/mkinitcpio.conf.d/$f" ] && mv -f "/etc/mkinitcpio.conf.d/$f" "/etc/mkinitcpio.conf.d/$f.zfs-orig"
+    done
+    cat > /etc/mkinitcpio.conf.d/zz-omarchy-zfs.conf <<EOF
+HOOKS=(base udev plymouth autodetect microcode modconf kms keyboard keymap consolefont block zfs filesystems fsck)
+FILES+=(/etc/zfs/zroot.key)
+EOF
+    rm -rf /etc/boot/hooks/pre.d /etc/boot/hooks/post.d
+    rm -f /etc/pacman.d/hooks/90-mkinitcpio-install.hook
+  '
+
+  # New Arch no longer ships kernel presets in /etc/mkinitcpio.d (a pacman hook
+  # generates them). Create an explicit preset so mkinitcpio -P has work to do.
+  #
+  # ALL_config MUST stay unset (commented), exactly like the stock
+  # /usr/share/mkinitcpio/hook.preset. Setting it makes process_preset pass
+  # "-c" to the nested mkinitcpio, and mkinitcpio only reads the
+  # /etc/mkinitcpio.conf.d drop-ins when no config was given via -c/preset
+  # (mkinitcpio sets _optconfd=0 for -c). Our zfs HOOKS/FILES live in
+  # zz-omarchy-zfs.conf, so with ALL_config set the initramfs gets built from
+  # the stock systemd hook set with no zfs -- root then fails to mount and
+  # systemd falls back to gpt-auto-root. Leave ALL_config commented out.
+  local pb pkgbase
+  for pb in "$target"/usr/lib/modules/*/pkgbase; do
+    pkgbase=$(cat "$pb")
+    cat >"$target/etc/mkinitcpio.d/${pkgbase}.preset" <<EOF
+#ALL_config="/etc/mkinitcpio.conf"
+ALL_kver="/boot/vmlinuz-${pkgbase}"
+PRESETS=('default')
+default_image="/boot/initramfs-${pkgbase}.img"
+EOF
+  done
+
+  _zfs_say "Configuring ZFSBootMenu"
+  mkdir -p "$target/etc/zfsbootmenu"
+  cat >"$target/etc/zfsbootmenu/config.yaml" <<EOF
+Global:
+  ManageImages: true
+  BootMountPoint: $esp_mount
+Components:
+  Enabled: false
+EFI:
+  Enabled: true
+  ImageDir: $esp_mount/EFI/zbm
+  Versions: false
+Kernel:
+  CommandLine: "ro quiet loglevel=4"
+EOF
+
+  _zfs_say "Enabling ZFS dataset auto-mount on boot"
+  # Datasets with canmount=on (home, /var/log, pkg cache) are mounted at boot by
+  # systemd's zfs-mount-generator, which turns /etc/zfs/zfs-list.cache/<pool>
+  # into .mount units pulled in by local-fs.target. zfs-zed refreshes that cache
+  # on pool import, but on a cold boot the generator runs before the OS imports
+  # the pool, so a fresh install would otherwise leave every non-root dataset
+  # unmounted -- most visibly the user's /home, which then breaks key-based SSH
+  # and looks like a failed install. Prime the cache at install time and enable
+  # the services that keep it current. The root dataset is canmount=noauto and
+  # is mounted by the initramfs, so the generator skips it; zfs-mount.service is
+  # deliberately NOT enabled -- it would race the generator's units.
+  #
+  # The pool is imported under an altroot ($target) here, and both `zfs list`
+  # and `zfs get` report mountpoints prefixed with it (/mnt/home). Feeding that
+  # to the generator would create .mount units for /mnt/home, i.e. mount nothing
+  # useful. Generate the cache from the live environment and strip the altroot
+  # prefix so it holds the real paths (/home).
+  target="${target%/}"
+  mkdir -p "$target/etc/zfs/zfs-list.cache"
+  zfs list -H -t filesystem \
+    -o name,mountpoint,canmount,atime,relatime,devices,exec,readonly,setuid,nbmand,encroot,keylocation |
+    awk -v root="$target" 'BEGIN { FS = OFS = "\t" }
+      $2 == root { $2 = "/" }
+      index($2, root "/") == 1 { $2 = substr($2, length(root) + 1) }
+      { print }' >"$target/etc/zfs/zfs-list.cache/$ZFS_POOL"
+  arch-chroot "$target" systemctl enable zfs-zed.service zfs.target
+
+  _zfs_say "Building initramfs + ZFSBootMenu bundle"
+  arch-chroot "$target" bash -euo pipefail -c '
+    # The kernel lives at /usr/lib/modules/<ver>/vmlinuz. mkinitcpio -P run
+    # directly (not via the pacman hook) does NOT copy it into /boot, so the
+    # preset all_kver path would be unreadable. Copy it first.
+    for mod in /usr/lib/modules/*/; do
+      [ -f "${mod}vmlinuz" ] || continue
+      ver=${mod%/}; ver=${ver##*/}
+      pkgbase=$(cat "${mod}pkgbase" 2>/dev/null || echo "$ver")
+      cp -f "${mod}vmlinuz" "/boot/vmlinuz-${pkgbase}"
+    done
+    mkinitcpio -P
+    generate-zbm
+    efi=$(ls '"$esp_mount"'/EFI/zbm/*.EFI 2>/dev/null | head -1)
+    [ -n "$efi" ] || { echo "BLAD: generate-zbm nie utworzyl bundle EFI"; exit 1; }
+    mkdir -p '"$esp_mount"'/EFI/BOOT
+    cp -f "$efi" '"$esp_mount"'/EFI/BOOT/BOOTX64.EFI
+  '
+}
+
+# Write the ZFS flavour of the pre-mounted fstab (ESP only). Kept here so the
+# Python phase can delegate instead of duplicating shell.
+zfs_write_fstab() {
+  local target="$1" esp_dev="$2" esp_mount="$3" uuid
+  uuid=$(blkid -s UUID -o value "$esp_dev")
+  cat >"$target/etc/fstab" <<EOF
+# /etc/fstab — generated by Omarchy ISO (ZFS root)
+# <device>  <mount>  <fs>  <options>  <dump>  <pass>
+UUID=$uuid  $esp_mount  vfat  umask=0077,nofail,x-systemd.automount  0 0
+EOF
+}
