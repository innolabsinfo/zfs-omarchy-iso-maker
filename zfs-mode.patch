+# ── ZFS ──────────────────────────────────────────────────────────────
+# ZFS is not in any configured repo (AUR only). Build the whole stack into a
+# local repo so it can go into BOTH the live environment (kernel linux-t2) and
+# the offline mirror (target kernel linux-omarchy).
+zfs_repo_dir=/var/cache/omarchy/mirror/aur
+mkdir -p "$zfs_repo_dir"
+id -u zfsbuilder >/dev/null 2>&1 || useradd -m -G wheel zfsbuilder
+chown zfsbuilder:zfsbuilder "$zfs_repo_dir"
+echo 'zfsbuilder ALL=(ALL) NOPASSWD: ALL' > /etc/sudoers.d/zfsbuilder
+openzfs_key=4F3BA9AB6D1F8D683DC2DFB56AD860EED4598027
+sudo -u zfsbuilder bash -euo pipefail -c "
+  curl -fsSL 'https://keyserver.ubuntu.com/pks/lookup?op=get&search=0x${openzfs_key}' | gpg --import
+  cd /tmp
+  for p in perl-boolean zfs-utils zfs-dkms zfsbootmenu; do
+    rm -rf \"\$p\"
+    git clone -q https://aur.archlinux.org/\"\$p\".git
+    if [ \"\$p\" = zfsbootmenu ]; then
+      # Skryptowy pakiet bez kompilacji - pomijamy instalowanie zaleznosci
+      # czasu budowy (zfs/perl-boolean sa potrzebne dopiero w systemie docelowym).
+      ( cd \"\$p\" && makepkg -d --noconfirm )
+    else
+      ( cd \"\$p\" && makepkg -s --noconfirm )
+    fi
+    cp \"\$p\"/*.pkg.tar.zst '$zfs_repo_dir'/
+  done
+  gpgconf --kill gpg-agent 2>/dev/null || true
+"
+repo-add "$zfs_repo_dir/aur.db.tar.gz" "$zfs_repo_dir/"*.pkg.tar.zst >/dev/null
+cat >> /etc/pacman.conf <<EOF
+
+[aur]
+SigLevel = Optional TrustAll
+Server = file://$zfs_repo_dir
+EOF
+pacman -Sy --noconfirm >/dev/null 2>&1 || true
+# The AUR packages are rebuilt every run with new checksums. A stale copy in the
+# shared pacman cache (mounted from the host at /var/cache/pacman/pkg) makes
+# mkarchiso reject the fresh ones as "corrupted (checksum)". Drop them so the
+# local [aur] repo wins.
+rm -f /var/cache/pacman/pkg/zfs-utils-* /var/cache/pacman/pkg/zfs-dkms-* \
+      /var/cache/pacman/pkg/zfsbootmenu-* /var/cache/pacman/pkg/perl-boolean-*
